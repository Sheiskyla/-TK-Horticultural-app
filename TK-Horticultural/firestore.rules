rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function owns(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Admins Collection
    match /admins/{uid} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // User Accounts Collection
    match /users/{uid} {
      allow read: if isAdmin() || owns(uid);
      allow create: if owns(uid)
        && request.resource.data.keys().hasOnly([
          'uid', 'displayName', 'email', 'phone', 'phoneNumber', 'address',
          'createdAt', 'lastActiveAt', 'isOnline', 'role', 'source',
          'photoURL', 'disabled', 'emailVerified', 'providers', 'updatedAt'
        ])
        && request.resource.data.uid == uid
        // Clients cannot self-grant admin role on creation
        && (!('role' in request.resource.data) || request.resource.data.role == 'client' || isAdmin());

      allow update: if isAdmin() || (
        owns(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'phone', 'phoneNumber', 'address', 'lastActiveAt', 'isOnline', 'photoURL', 'updatedAt', 'providers', 'email', 'createdAt', 'role'
        ])
        && request.resource.data.uid == uid
        && (!('role' in request.resource.data) || request.resource.data.role == resource.data.role || request.resource.data.role == 'client' || isAdmin())
      );

      allow delete: if isAdmin();
    }

    // Bookings Management
    match /bookings/{bookingId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status in ['Pending', 'Pending Quote']
        && request.resource.data.keys().hasOnly([
          'userId', 'customerName', 'customerEmail', 'customerPhone', 'ref',
          'service', 'division', 'date', 'slotId', 'slot', 'address',
          'location', 'jobDetails', 'jobFiles', 'attachments', 'createdAt', 'status'
        ]);
      allow update: if isAdmin()
        || (owns(resource.data.userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'Cancelled');
      allow delete: if isAdmin();
    }

    // Slot Reservations
    match /slots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.keys().hasOnly(['date', 'slotId', 'userId', 'createdAt'])
        && slotId == request.resource.data.date + '_' + request.resource.data.slotId;
      allow update: if isAdmin();
      allow delete: if isAdmin() || owns(resource.data.userId);
    }

    // Daily Specific Availability Control
    match /availability/{date} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Default Weekly Recurring Availability Control
    match /availability_defaults/{weekday} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Quotes
    match /quotes/{quoteId} {
      allow read: if isAdmin() || owns(resource.data.userId);
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'New';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Gallery Showcase
    match /gallery/{itemId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    // Enquiries Collection
    match /enquiries/{enquiryId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'message', 'createdAt'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 254
        && request.resource.data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.message is string
        && request.resource.data.message.size() >= 1
        && request.resource.data.message.size() <= 5000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
